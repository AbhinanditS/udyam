---
/**
 * Shared page shell: metadata, fonts, structured data, header and footer.
 */
import '@/styles/global.css';
import { Font } from 'astro:assets';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { siteConfig } from '@/data/site-config';
import { activeSocialLinks } from '@/data/social-links';
import { localeMeta, localizePath, locales, stripLocale, useTranslations, type Locale } from '@/i18n';
import { pageContext } from '@/utils/locale';

export type BreadcrumbItem = { name: string; path: string };

interface Props {
  /** Page title without the site name. */
  title: string;
  description?: string | undefined;
  /** Path of a 1200 x 630 image inside public/. */
  ogImage?: string;
  noindex?: boolean;
  /** Puts the site name first, for the home page. */
  isHome?: boolean;
  /** Target of the language switch when it differs from the same path, for example on 404 pages. */
  alternatePaths?: Partial<Record<Locale, string>>;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  ogImage = '/og/udyamsetu-og.png',
  noindex = false,
  isHome = false,
  alternatePaths,
  breadcrumbs = [],
} = Astro.props;

const { locale, t } = pageContext(Astro.url);
const site = Astro.site ?? new URL('https://udyamsetu.pages.dev');
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, site).toString();
const basePath = stripLocale(pathname);
const alternates = locales.map((code) => ({
  hreflang: localeMeta[code].hreflang,
  href: new URL(alternatePaths?.[code] ?? localizePath(basePath, code), site).toString(),
}));
const fullTitle = isHome
  ? `${t.meta.siteName}${t.meta.titleSeparator}${title}`
  : `${title}${t.meta.titleSeparator}${t.meta.siteName}`;
const metaDescription = description ?? t.meta.defaultDescription;
const ogImageUrl = new URL(ogImage, site).toString();
const blockIndexing = noindex || __PREVIEW_BUILD__;
const otherLocales = locales.filter((code) => code !== locale);

const en = useTranslations('en');
const { email, phone, address } = siteConfig.contact;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', site).toString(),
  name: en.brand.fullName,
  alternateName: en.brand.name,
  url: new URL('/', site).toString(),
  logo: new URL('/brand/udyamsetu-emblem-512.png', site).toString(),
  slogan: en.brand.tagline,
  description: en.meta.defaultDescription,
  areaServed: { '@type': 'Country', name: 'India' },
  ...(email ? { email } : {}),
  ...(phone ? { telephone: phone } : {}),
  ...(address.en ? { address: address.en } : {}),
  ...(activeSocialLinks.length ? { sameAs: activeSocialLinks.map((link) => link.url) } : {}),
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: en.brand.fullName,
  url: new URL('/', site).toString(),
  inLanguage: locales.map((code) => localeMeta[code].hreflang),
  publisher: { '@id': organization['@id'] },
};
const breadcrumbList =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: new URL(item.path, site).toString(),
        })),
      }
    : null;
const structuredData = [organization, ...(isHome ? [website] : []), ...(breadcrumbList ? [breadcrumbList] : [])];
const analyticsToken = siteConfig.analytics.cloudflareToken;
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />
    <meta name="robots" content={blockIndexing ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#122842" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${t.brand.fullName}. ${t.brand.tagline}`} />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    {otherLocales.map((code) => <meta property="og:locale:alternate" content={localeMeta[code].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <Font
      cssVariable="--font-lato"
      preload={locale === 'hi' ? [{ weight: 700, style: 'normal' }] : [{ weight: 400, style: 'normal' }, { weight: 700, style: 'normal' }]}
    />
    <Font cssVariable="--font-devanagari" preload={locale === 'hi'} />
    <Font cssVariable="--font-plex-mono" />

    <script is:inline>
      // Reveals content groups once as they scroll into view. Skipped when motion is reduced.
      (function () {
        if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('reveal-ready');
        document.addEventListener('DOMContentLoaded', function () {
          const observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-revealed');
                  observer.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -6% 0px', threshold: 0.04 },
          );
          document.querySelectorAll('[data-reveal]').forEach(function (el) {
            observer.observe(el);
          });
        });
      })();
    </script>

    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header alternatePaths={alternatePaths} />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer alternatePaths={alternatePaths} />
    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </body>
</html>
