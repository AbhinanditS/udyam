---
import SocialIcon from './SocialIcon.astro';
import { activeSocialLinks } from '@/data/social-links';
import { pageContext } from '@/utils/locale';

interface Props {
  tone?: 'light' | 'dark';
  size?: 'sm' | 'md';
  class?: string;
}

const { tone = 'light', size = 'md', class: className } = Astro.props;
const { t } = pageContext(Astro.url);
const box = size === 'sm' ? 'h-8 w-8' : 'h-10 w-10';
const colors =
  tone === 'dark'
    ? 'text-on-dark-2 hover:bg-white/6 hover:text-on-dark active:bg-white/10'
    : 'text-ink-2 hover:bg-navy-50 hover:text-ink active:bg-navy-100';
---

{
  activeSocialLinks.length > 0 && (
    <ul class:list={['flex items-center gap-1', className]} aria-label={t.header.social}>
      {activeSocialLinks.map((link) => (
        <li>
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer me"
            class:list={[
              'inline-flex items-center justify-center rounded-sm transition-[background-color,color,transform] duration-[80ms] ease-out active:scale-[0.97]',
              box,
              colors,
            ]}
          >
            <SocialIcon platform={link.platform} size={size === 'sm' ? 15 : 17} />
            <span class="sr-only">
              {link.label} {t.common.opensInNewTab}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}
