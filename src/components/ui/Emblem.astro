---
/**
 * Temporary geometric emblem: a tied-arch bridge ("setu") over a gold deck.
 * Replace this component when the registered UdyamSetu logo is available.
 */
interface Props {
  size?: number;
  class?: string;
  /** Use 'dark' on navy backgrounds. */
  tone?: 'light' | 'dark';
}

const { size = 36, class: className, tone = 'light' } = Astro.props;
const tile = tone === 'dark' ? '#1a3658' : '#122842';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="40" height="40" rx="6" fill={tile}></rect>
  <path d="M8 28 A12 12 0 0 1 32 28" fill="none" stroke="#f3f6f9" stroke-width="3.2"></path>
  <path d="M14 28 V17.6 M20 28 V16 M26 28 V17.6" fill="none" stroke="#f3f6f9" stroke-width="1.6" opacity="0.55"></path>
  <path d="M6 28 H34" fill="none" stroke="#d4a94b" stroke-width="3.2"></path>
</svg>
