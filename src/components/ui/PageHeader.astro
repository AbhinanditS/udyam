---
/**
 * Header band for inner pages: breadcrumb, title, lead and an optional "On this page" index.
 */
import Icon, { type AnyIconName } from './Icon.astro';
import { pageContext } from '@/utils/locale';

export type Crumb = { label: string; href?: string };

interface Props {
  eyebrow: string;
  title: string;
  lead?: string | undefined;
  crumbs?: Crumb[];
  sections?: { id: string; label: string }[];
  icon?: AnyIconName | undefined;
}

const { eyebrow, title, lead, crumbs = [], sections = [], icon } = Astro.props;
const { t, href } = pageContext(Astro.url);
const trail: Crumb[] = [{ label: t.nav.home, href: href('home') }, ...crumbs];
const showIndex = sections.length > 1;
---

<header class="border-b border-line bg-surface">
  <div class="container-site pt-7 pb-12 lg:pt-8 lg:pb-16">
    <nav aria-label={t.common.breadcrumb}>
      <ol class="meta flex flex-wrap items-center gap-x-2 gap-y-1">
        {
          trail.map((crumb, i) => (
            <li class="flex items-center gap-2">
              {i > 0 && (
                <span aria-hidden="true" class="text-line-strong">
                  /
                </span>
              )}
              {crumb.href && i < trail.length - 1 ? (
                <a href={crumb.href} class="rounded-xs transition-colors duration-[80ms] hover:text-ink">
                  {crumb.label}
                </a>
              ) : (
                <span aria-current="page" class="text-ink-2">
                  {crumb.label}
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    <div class:list={['mt-10 grid gap-10 lg:mt-12', showIndex && 'lg:grid-cols-12']}>
      <div class:list={[showIndex && 'lg:col-span-8']}>
        {
          icon && (
            <div class="mb-6">
              <span class="icon-tile h-12 w-12">
                <Icon name={icon} size={24} />
              </span>
            </div>
          )
        }
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="h1 mt-4 max-w-[22ch]">{title}</h1>
        {lead && <p class="lead mt-5">{lead}</p>}
        <slot />
      </div>

      {
        showIndex && (
          <nav aria-label={t.common.onThisPage} class="lg:col-span-4 lg:border-l lg:border-line lg:pl-10">
            <p class="meta">{t.common.onThisPage}</p>
            <ol class="mt-3 grid gap-px sm:grid-cols-2 lg:grid-cols-1">
              {sections.map((section, i) => (
                <li>
                  <a
                    href={`#${section.id}`}
                    class="group flex items-baseline gap-3 rounded-xs py-1.5 text-ink-2 transition-colors duration-[80ms] hover:text-ink"
                  >
                    <span class="meta tabular text-ink-3 group-hover:text-ink">{String(i + 1).padStart(2, '0')}</span>
                    <span class="font-bold">{section.label}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </div>
  </div>
</header>
