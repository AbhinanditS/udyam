---
/** Leader photograph, or initials on a quiet tile when no photograph has been supplied. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  name: string;
  photo?: ImageMetadata | undefined;
  alt?: string;
  class?: string;
  width?: number;
}

const { name, photo, alt = '', class: className, width = 640 } = Astro.props;
const initials = name
  .replace(/^(dr|mr|ms|mrs|shri|smt)\.?\s+/i, '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase())
  .join('');
---

{
  photo ? (
    <Image src={photo} alt={alt} width={width} class:list={['object-cover', className]} loading="lazy" />
  ) : (
    <div
      class:list={['flex items-center justify-center border border-navy-100 bg-navy-50 text-navy-700', className]}
      aria-hidden="true"
    >
      <span class="text-3xl font-black tracking-tight">{initials}</span>
    </div>
  )
}
