---
import Icon from '@/components/ui/Icon.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import EditorialNote from '@/components/ui/EditorialNote.astro';
import LangText from '@/components/ui/LangText.astro';
import Portrait from './Portrait.astro';
import { pickText } from '@/i18n';
import { getPublishedLeaders } from '@/utils/content';
import { pageContext } from '@/utils/locale';

const { locale, t } = pageContext(Astro.url);
const copy = t.about.leadership;
const { managingDirector: md, board, executive, total } = await getPublishedLeaders();
---

{
  total === 0 ? (
    <div class="space-y-4">
      <EmptyState icon="users" title={copy.emptyTitle} text={copy.emptyText} />
      <EditorialNote file="src/content/leadership/">
        No leadership profile is published. Copy an example file for the Managing Director, each Board member and each
        Executive Board member, add the photograph next to it, fill in the verified details and set status: published.
      </EditorialNote>
    </div>
  ) : (
    <div class="space-y-16">
      {md && (
        <article class="card grid gap-8 p-6 sm:p-8 lg:grid-cols-12 lg:gap-10" aria-labelledby="md-name">
          <Portrait
            name={md.data.name}
            photo={md.data.photo}
            alt={pickText(md.data.photoAlt, locale)}
            class="aspect-[4/5] w-full max-w-xs rounded-md lg:col-span-4 lg:max-w-none"
          />
          <div class="lg:col-span-8">
            <p class="eyebrow">{copy.md}</p>
            <h3 id="md-name" class="h2 mt-3">
              {md.data.name}
            </h3>
            <LangText value={md.data.designation} as="p" class="meta mt-2" />
            {md.data.message && (
              <figure class="mt-8 border-l-2 border-gold-400 pl-6">
                <figcaption class="meta">{copy.message}</figcaption>
                <LangText value={md.data.message} as="blockquote" class="mt-3 text-xl leading-relaxed text-ink" />
              </figure>
            )}
            {md.data.bio && <LangText value={md.data.bio} as="p" class="measure mt-8 text-ink-2" />}
            {md.data.linkedin && (
              <a href={md.data.linkedin} class="link-arrow mt-6 text-sm" target="_blank" rel="noopener noreferrer">
                {copy.profileOn}
                <Icon name="arrow-up-right" size={16} />
                <span class="sr-only">{t.common.opensInNewTab}</span>
              </a>
            )}
          </div>
        </article>
      )}

      {board.length > 0 && (
        <div>
          <h3 class="h3">{copy.board}</h3>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {board.map((member) => (
              <li class="card flex flex-col overflow-hidden">
                <Portrait
                  name={member.data.name}
                  photo={member.data.photo}
                  alt={pickText(member.data.photoAlt, locale)}
                  class="aspect-[4/3] w-full"
                />
                <div class="flex flex-1 flex-col p-5">
                  <h4 class="h4">{member.data.name}</h4>
                  <LangText value={member.data.designation} as="p" class="meta mt-1.5" />
                  {member.data.bio && <LangText value={member.data.bio} as="p" class="mt-4 text-sm text-ink-2" />}
                  {member.data.background && (
                    <div class="mt-4 border-t border-line pt-4">
                      <p class="meta">{copy.background}</p>
                      <LangText value={member.data.background} as="p" class="mt-1.5 text-sm text-ink-2" />
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      )}

      {executive.length > 0 && (
        <div class="carousel" data-carousel>
          <div class="flex items-end justify-between gap-4">
            <h3 class="h3">{copy.executive}</h3>
            <div class="flex gap-2" data-controls>
              <button type="button" class="icon-btn" data-prev aria-controls="executive-rail">
                <Icon name="chevron-left" />
                <span class="sr-only">{copy.previous}</span>
              </button>
              <button type="button" class="icon-btn" data-next aria-controls="executive-rail">
                <Icon name="chevron-right" />
                <span class="sr-only">{copy.next}</span>
              </button>
            </div>
          </div>
          {/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- the scroll rail must be reachable by keyboard */}
          <ul
            id="executive-rail"
            class="rail mt-6 auto-cols-[minmax(15rem,80%)] sm:auto-cols-[minmax(16rem,45%)] lg:auto-cols-[calc((100%-3rem)/4)]"
            data-rail
            tabindex="0"
            aria-label={copy.executive}
          >
{/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
            {executive.map((member) => (
              <li class="card flex flex-col overflow-hidden">
                <Portrait
                  name={member.data.name}
                  photo={member.data.photo}
                  alt={pickText(member.data.photoAlt, locale)}
                  class="aspect-square w-full"
                />
                <div class="flex flex-1 flex-col p-5">
                  <h4 class="h4">{member.data.name}</h4>
                  <LangText value={member.data.designation} as="p" class="meta mt-1.5" />
                  {member.data.expertise && (
                    <div class="mt-4">
                      <p class="meta">{copy.expertise}</p>
                      <LangText value={member.data.expertise} as="p" class="mt-1 text-sm font-bold text-ink" />
                    </div>
                  )}
                  {member.data.background && (
                    <LangText value={member.data.background} as="p" class="mt-3 text-sm text-ink-2" />
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )
}

<script>
  import { initCarousels } from '@/scripts/carousel';
  initCarousels();
</script>
