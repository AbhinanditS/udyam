---
/**
 * Original hero diagram: a tied-arch bridge (setu) that carries skills to livelihoods,
 * with trainers, entrepreneurs and communities supported along the deck.
 */
import { pageContext } from '@/utils/locale';

const { locale, t } = pageContext(Astro.url);
const labels = t.home.hero.diagramNodes;

const cx = 300;
const deck = 300;
const rx = 220;
const ry = 196;
const archY = (x: number) => deck - ry * Math.sqrt(Math.max(0, 1 - ((x - cx) / rx) ** 2));
const nodes = [168, 300, 432];
const faint = [124, 234, 366, 476];
const labelClass = locale === 'hi' ? 'diagram-label diagram-label-hi' : 'diagram-label';
---

<svg
  viewBox="0 84 600 304"
  class="h-auto w-full"
  role="img"
  aria-label={t.home.hero.diagramLabel}
  xmlns="http://www.w3.org/2000/svg"
>
  <line x1="24" y1="344" x2="576" y2="344" stroke="#93a4b8" stroke-opacity="0.4" stroke-dasharray="2 6"></line>
  <rect x="74" y="300" width="12" height="44" fill="#24476f"></rect>
  <rect x="514" y="300" width="12" height="44" fill="#24476f"></rect>

  {
    faint.map((x) => (
      <line x1={x} y1={deck} x2={x} y2={archY(x).toFixed(1)} stroke="#93a4b8" stroke-opacity="0.32" stroke-width="1" />
    ))
  }
  {nodes.map((x) => <line x1={x} y1={deck} x2={x} y2={archY(x).toFixed(1)} stroke="#93a4b8" stroke-width="1.25" />)}

  <path d={`M${cx - rx} ${deck} A${rx} ${ry} 0 0 1 ${cx + rx} ${deck}`} fill="none" stroke="#c2cdd9" stroke-width="2.5"></path>
  <line x1="24" y1={deck} x2="568" y2={deck} stroke="#f3f6f9" stroke-width="3"></line>
  <path d={`M562 ${deck - 6} L572 ${deck} L562 ${deck + 6}`} fill="none" stroke="#f3f6f9" stroke-width="2"></path>

  <circle cx={cx} cy={deck - ry} r="5.5" fill="#d4a94b"></circle>

  {
    nodes.map((x, i) => (
      <g>
        <circle cx={x} cy={deck} r="7" fill="#122842" stroke="#f3f6f9" stroke-width="2" />
        <text x={x} y="336" text-anchor="middle" class={labelClass}>
          {labels[i]}
        </text>
      </g>
    ))
  }

  <text x="80" y="378" text-anchor="middle" class={`${labelClass} diagram-label-muted`}>{t.home.hero.diagramFrom}</text>
  <text x="520" y="378" text-anchor="middle" class={`${labelClass} diagram-label-muted`}>{t.home.hero.diagramTo}</text>
</svg>

<style>
  .diagram-label {
    fill: #c2cdd9;
    font-family: var(--font-plex-mono);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .diagram-label-hi {
    font-family: var(--font-devanagari), var(--font-lato);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }

  .diagram-label-muted {
    fill: #93a4b8;
  }
</style>
