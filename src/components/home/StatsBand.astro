---
import Icon from '@/components/ui/Icon.astro';
import StatFigure from '@/components/sections/StatFigure.astro';
import { headlineStats, isPublished } from '@/data/statistics';
import { pageContext } from '@/utils/locale';

const { t, href } = pageContext(Astro.url);
const stats = headlineStats.filter(isPublished);
---

{
  stats.length > 0 && (
    <section class="section-tight" aria-labelledby="stats-title">
      <div class="container-site">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">{t.home.stats.eyebrow}</p>
            <h2 id="stats-title" class="h2 mt-3">
              {t.home.stats.title}
            </h2>
          </div>
          <a href={href('impact')} class="link-arrow shrink-0">
            {t.home.stats.link}
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
        <dl class="mt-10 grid gap-8 border-t border-line pt-8 sm:grid-cols-3 sm:gap-0" data-reveal>
          {stats.map((stat, i) => (
            <StatFigure stat={stat} class:list={['sm:px-8', i === 0 ? 'sm:pl-0' : 'sm:border-l sm:border-line']} />
          ))}
        </dl>
      </div>
    </section>
  )
}
