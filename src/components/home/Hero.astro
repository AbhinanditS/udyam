---
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import BridgeDiagram from './BridgeDiagram.astro';
import { siteConfig } from '@/data/site-config';
import { pickText } from '@/i18n';
import { pageContext } from '@/utils/locale';
import { sitePhotos } from '@/utils/photos';

const { locale, t, href } = pageContext(Astro.url);
const hero = t.home.hero;
const photo = sitePhotos.hero;
const photoAlt = pickText(siteConfig.photos.hero.alt, locale);
const apps = [
  { label: hero.trainerApp, url: siteConfig.apps.trainerPlayStore, anchor: 'trainer-app' },
  { label: hero.traineeApp, url: siteConfig.apps.traineePlayStore, anchor: 'trainee-app' },
];
---

<section class="on-dark relative isolate overflow-hidden bg-navy-900" aria-labelledby="hero-title">
  {
    photo && (
      <div class="absolute inset-0 -z-10" aria-hidden={photoAlt ? undefined : 'true'}>
        <Image
          src={photo}
          alt={photoAlt}
          layout="full-width"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,var(--color-navy-900)_0%,rgb(18_40_66/0.92)_42%,rgb(18_40_66/0.55)_100%)]" />
      </div>
    )
  }

  <div class="container-site grid gap-12 pt-14 pb-28 sm:pt-20 lg:grid-cols-12 lg:items-center lg:gap-10 lg:pt-24 lg:pb-36">
    <div class="lg:col-span-7">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title" class="h-display mt-5 max-w-[15ch]">{hero.title}</h1>
      <p class="lead mt-6 max-w-[46ch]">{hero.lead}</p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <Button href={href('collaborations', 'partner-with-us')} variant="gold" icon="arrow-right">
          {hero.partner}
        </Button>
        {
          apps.map((app) =>
            app.url ? (
              <Button href={app.url} variant="on-dark" icon="smartphone" iconPosition="start">
                {app.label}
              </Button>
            ) : (
              <Button href={href('apps', app.anchor)} variant="on-dark" badge={t.common.comingSoon}>
                {app.label}
              </Button>
            ),
          )
        }
      </div>

      <a
        href="#overview"
        class="group mt-14 hidden items-center gap-2 rounded-sm text-on-dark-3 transition-colors duration-[80ms] hover:text-on-dark lg:inline-flex"
        aria-label={hero.scrollLabel}
      >
        <span class="meta">{hero.scroll}</span>
        <Icon name="arrow-down" size={16} class="transition-transform duration-150 group-hover:translate-y-0.5" />
      </a>
    </div>

    {
      !photo && (
        <div class="hidden md:block lg:col-span-5">
          <div class="rounded-md border border-line-dark p-6 lg:p-8">
            <BridgeDiagram />
          </div>
        </div>
      )
    }
  </div>
</section>
