---
import Icon from '@/components/ui/Icon.astro';
import StatFigure from '@/components/sections/StatFigure.astro';
import { impactIndicators, isPublished } from '@/data/statistics';
import { pick } from '@/i18n';
import { pageContext } from '@/utils/locale';

const { locale, t } = pageContext(Astro.url);
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
  {
    impactIndicators.map((indicator) => {
      const label = pick(indicator.label, locale);
      const description = pick(indicator.description, locale);
      return (
        <li class="card flex flex-col p-6">
          <span class="icon-tile">
            <Icon name={indicator.icon} />
          </span>
          {isPublished(indicator) ? (
            <dl class="mt-6">
              <StatFigure stat={indicator} />
            </dl>
          ) : (
            <div class="mt-6">
              <h3 class="h4" lang={label.isFallback ? 'en' : undefined}>
                {label.text}
              </h3>
              <p class="mt-3">
                <span class="badge badge-pending badge-dot">{t.impact.dashboard.pending}</span>
              </p>
            </div>
          )}
          <p class="mt-4 border-t border-line pt-4 text-sm text-ink-2" lang={description.isFallback ? 'en' : undefined}>
            {description.text}
          </p>
        </li>
      );
    })
  }
</ul>
