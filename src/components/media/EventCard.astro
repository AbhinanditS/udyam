---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import LangText from '@/components/ui/LangText.astro';
import { formatDate, pickText } from '@/i18n';
import { pageContext } from '@/utils/locale';

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
const { locale, t } = pageContext(Astro.url);
const data = event.data;
const start = data.startDate as Date;
const range = data.endDate && data.endDate.getTime() !== start.getTime()
  ? `${formatDate(start, locale)} – ${formatDate(data.endDate, locale)}`
  : formatDate(start, locale);
---

<article class="card grid overflow-hidden sm:grid-cols-[8rem_1fr] lg:grid-cols-[8rem_1fr_16rem]">
  <div class="flex flex-row items-baseline gap-2 border-b border-line bg-navy-50 px-6 py-4 sm:flex-col sm:items-center sm:justify-center sm:border-r sm:border-b-0">
    <span class="meta">{formatDate(start, locale, { month: 'short' })}</span>
    <span class="tabular text-4xl leading-none font-black text-navy-900">{formatDate(start, locale, { day: 'numeric' })}</span>
    <span class="meta">{formatDate(start, locale, { year: 'numeric' })}</span>
  </div>
  <div class="p-6">
    <LangText value={data.title} as="h3" class="h3" />
    <p class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-2">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="calendar" size={16} class="text-ink-3" />
        <span class="sr-only">{t.media.events.date}:</span>
        {range}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Icon name="map-pin" size={16} class="text-ink-3" />
        <span class="sr-only">{t.media.events.location}:</span>
        <LangText value={data.location} />
      </span>
    </p>
    <LangText value={data.description} as="p" class="mt-4 max-w-[62ch] text-ink-2" />
    {
      data.registrationUrl && (
        <Button href={data.registrationUrl} size="sm" class="mt-5">
          {t.media.events.register}
        </Button>
      )
    }
  </div>
  {
    data.image && (
      <Image
        src={data.image}
        alt={pickText(data.imageAlt, locale)}
        width={640}
        class="hidden h-full w-full object-cover lg:block"
        loading="lazy"
      />
    )
  }
</article>
