---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TallyForm from '@/components/forms/TallyForm.astro';
import EditorialNote from '@/components/ui/EditorialNote.astro';
import Icon from '@/components/ui/Icon.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import { siteConfig } from '@/data/site-config';
import { activeSocialLinks } from '@/data/social-links';
import { localeStaticPaths, pick } from '@/i18n';
import { pageContext } from '@/utils/locale';
import { telHref } from '@/utils/urls';

export function getStaticPaths() {
  return localeStaticPaths();
}

const { locale, t, href } = pageContext(Astro.url);
const copy = t.contact;
const { address, email, phone, map } = siteConfig.contact;
const addressText = address.en ? pick(address, locale) : null;
const siteUrl = (Astro.site ?? new URL('https://udyamsetu.pages.dev')).toString();
const siteLabel = siteUrl.replace(/^https?:\/\//, '').replace(/\/$/, '');
const hasDetails = Boolean(addressText || email || phone);
const hasMap = typeof map.latitude === 'number' && typeof map.longitude === 'number' && Boolean(addressText);
const delta = 0.006;
const mapEmbed = hasMap
  ? `https://www.openstreetmap.org/export/embed.html?bbox=${map.longitude! - delta}%2C${map.latitude! - delta}%2C${map.longitude! + delta}%2C${map.latitude! + delta}&layer=mapnik&marker=${map.latitude}%2C${map.longitude}`
  : null;
const mapLink = hasMap
  ? `https://www.openstreetmap.org/?mlat=${map.latitude}&mlon=${map.longitude}#map=${map.zoom}/${map.latitude}/${map.longitude}`
  : null;
---

<BaseLayout
  title={copy.seoTitle}
  description={copy.seoDescription}
  breadcrumbs={[
    { name: t.nav.home, path: href('home') },
    { name: t.nav.contact, path: href('contact') },
  ]}
>
  <PageHeader eyebrow={copy.header.eyebrow} title={copy.header.title} lead={copy.header.lead} crumbs={[{ label: t.nav.contact }]} />

  <section class="section" aria-label={copy.header.title}>
    <div class="container-site grid gap-6 lg:grid-cols-12 lg:gap-8">
      <div class="space-y-6 lg:col-span-5">
        <div class="card p-6 sm:p-8">
          <h2 class="h3">{copy.details.title}</h2>
          <p class="mt-4 text-lg font-black text-navy-900" lang="en">UdyamSetu Pvt. Ltd.</p>
          <div class="mt-6 space-y-5">
            {
              addressText && (
                <div class="flex gap-4">
                  <Icon name="map-pin" class="mt-0.5 shrink-0 text-ink-3" />
                  <dl>
                    <dt class="meta">{copy.details.address}</dt>
                    <dd class="mt-1 whitespace-pre-line text-ink" lang={addressText.isFallback ? 'en' : undefined}>
                      {addressText.text}
                    </dd>
                  </dl>
                </div>
              )
            }
            {
              email && (
                <div class="flex gap-4">
                  <Icon name="mail" class="mt-0.5 shrink-0 text-ink-3" />
                  <dl>
                    <dt class="meta">{copy.details.email}</dt>
                    <dd class="mt-1">
                      <a href={`mailto:${email}`} class="link font-bold">
                        {email}
                      </a>
                    </dd>
                  </dl>
                </div>
              )
            }
            {
              phone && (
                <div class="flex gap-4">
                  <Icon name="phone" class="mt-0.5 shrink-0 text-ink-3" />
                  <dl>
                    <dt class="meta">{copy.details.phone}</dt>
                    <dd class="mt-1">
                      <a href={telHref(phone)} class="link font-bold">
                        {phone}
                      </a>
                    </dd>
                  </dl>
                </div>
              )
            }
            <div class="flex gap-4">
              <Icon name="globe" class="mt-0.5 shrink-0 text-ink-3" />
              <dl>
                <dt class="meta">{copy.details.website}</dt>
                <dd class="mt-1">
                  <a href={siteUrl} class="link font-bold">
                    {siteLabel}
                  </a>
                </dd>
              </dl>
            </div>
          </div>
          {
            !hasDetails && (
              <p class="mt-6 border-t border-line pt-5 text-ink-2" role="note">
                {copy.details.unavailable}
              </p>
            )
          }
          <EditorialNote class="mt-6" file="src/data/site-config.ts → contact">
            Add the verified corporate office address, email and phone. The map appears when the address and the office
            latitude and longitude are set.
          </EditorialNote>
        </div>

        {
          mapEmbed && mapLink && (
            <div class="card overflow-hidden">
              <h2 class="sr-only">{copy.map.title}</h2>
              <iframe
                src={mapEmbed}
                title={copy.map.iframeTitle}
                class="block aspect-[4/3] w-full border-0"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              />
              <div class="flex items-center justify-between gap-4 border-t border-line px-5 py-3 text-sm">
                <span class="text-ink-3">© OpenStreetMap contributors</span>
                <a href={mapLink} class="link-arrow" target="_blank" rel="noopener noreferrer">
                  {copy.map.larger}
                  <Icon name="arrow-up-right" size={16} />
                  <span class="sr-only">{t.common.opensInNewTab}</span>
                </a>
              </div>
            </div>
          )
        }

        {
          activeSocialLinks.length > 0 && (
            <div class="card p-6">
              <h2 class="meta">{copy.social}</h2>
              <SocialLinks class="mt-3 -ml-2" />
            </div>
          )
        }
      </div>

      <div class="lg:col-span-7">
        <div class="card p-6 sm:p-8">
          <h2 class="h3">{copy.form.title}</h2>
          <p class="mt-2 text-ink-2">{copy.form.text}</p>
          <TallyForm form="contact" height={520} class="mt-6" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
