# Copy this file to .env for local development. Never commit .env.
# In production, set the same names in Cloudflare Pages:
# Workers & Pages > your project > Settings > Variables and Secrets.
# Every variable is optional. A missing value shows a "coming soon" or "not available yet" state.

# Production address, used for canonical URLs, the sitemap and Open Graph tags.
SITE_URL=https://udyamsetu.pages.dev

# Tally form share links (Share > Link in Tally), for example https://tally.so/r/abc123
PUBLIC_TALLY_CONTACT_URL=
PUBLIC_TALLY_PARTNERSHIP_URL=
PUBLIC_TALLY_RESEARCH_URL=
PUBLIC_TALLY_CAREERS_URL=
PUBLIC_TALLY_NEWSLETTER_URL=

# Google Play Store listings of the apps, and the web login of the existing application.
PUBLIC_TRAINER_APP_URL=
PUBLIC_TRAINEE_APP_URL=
PUBLIC_APP_LOGIN_URL=

# Cloudflare Web Analytics site token. Leave empty if Web Analytics is enabled
# from the Cloudflare Pages dashboard, which adds the script automatically.
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Set to true on preview deployments to show notes about content that still needs approval.
# Notes always show in local development (npm run dev).
PUBLIC_SHOW_EDITORIAL_NOTES=false

# Branch that Cloudflare Pages deploys to production. Other branches get a noindex tag.
PRODUCTION_BRANCH=main
